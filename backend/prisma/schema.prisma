// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String?
  username  String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders    Order[]
  holdings  Holding[]

  @@map("profiles")
}

model Listing {
  id               String   @id @default(cuid())
  title            String
  description      String?
  location         String
  price            Decimal  @db.Decimal(18, 2)
  totalTokens      Int
  availableTokens  Int
  tokenPrice       Decimal  @db.Decimal(18, 6)
  images           String[] @default([])
  propertyType     String?
  bedrooms         Int?
  bathrooms        Int?
  squareFeet       Int?
  yearBuilt        Int?
  status           ListingStatus @default(ACTIVE)
  aiValuation      Decimal? @db.Decimal(18, 2)
  valuationDate    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Blockchain fields
  mintAddress      String?  @unique
  escrowAddress    String?
  
  // Relations
  orders           Order[]
  transactions     Transaction[]
  holdings         Holding[]

  @@map("listings")
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  INACTIVE
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  listingId     String
  quantity      Int
  totalAmount   Decimal     @db.Decimal(18, 6)
  status        OrderStatus @default(PENDING)
  paymentMethod String      @default("FIAT")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Blockchain fields
  escrowAddress String?
  signature     String?

  // Relations
  profile       Profile @relation(fields: [userId], references: [userId])
  listing       Listing @relation(fields: [listingId], references: [id])
  transactions  Transaction[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Transaction {
  id          String            @id @default(cuid())
  orderId     String?
  listingId   String
  userId      String
  type        TransactionType
  amount      Decimal           @db.Decimal(18, 6)
  quantity    Int?
  signature   String?
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  order       Order?   @relation(fields: [orderId], references: [id])
  listing     Listing  @relation(fields: [listingId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  PURCHASE
  MINT
  TRANSFER
  ESCROW_RELEASE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Holding {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile   Profile @relation(fields: [userId], references: [userId])
  listing   Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
  @@map("holdings")
}

